{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Todo Task",
  "type": "object",
  "required": ["id", "title", "status", "horizon", "area", "priority", "created", "updated"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["active", "waiting", "done", "dropped"]},
    "horizon": {"enum": ["today", "week", "month", "quarter", "year", "decade", "lifetime"]},
    "area": {"type": "string"},
    "priority": {"enum": ["high", "medium", "low"]},
    "due": {"type": "string"},
    "nextAction": {"type": "string"},
    "notes": {"type": "string"},
    "created": {"type": "string"},
    "updated": {"type": "string"}
  }
}
