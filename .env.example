# LLM Todo 配置项
# 复制此文件为 .env 并修改

# 访问令牌（可选，设置后需在 Header 中传入 Bearer Token）
LLM_TODO_TOKEN=

# 远程同步地址（可选，用于推送代码/数据到远程平台）
# 如: http://<SERVER_IP>
LLM_TODO_REMOTE_SYNC_URL=

# 远程同步 Token（可选，远程平台认证用）
LLM_TODO_REMOTE_SYNC_TOKEN=

# LLM 聊天配置
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_MODEL=deepseek-chat

# GLM 配置
GLM_API_KEY=73a397915e3646f9ab9d9ed7cfd04611.CXQiVkPOEqkuTe1G
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# HTTP 端口（默认 8720）
LLM_TODO_PORT=8720
